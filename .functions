function localip() {
	if [[ "${OSTYPE}" =~ ^linux ]]; then
		ip -4 -o addr show $(ip route get 8.8.8.8 | awk '/8.8.8.8/ {print $5}') |\
		grep -Eo "([[:digit:]]{1,3}\.){3}[[:digit:]]{1,3}" |\
		head -n 1
	elif [[ "${OSTYPE}" =~ ^darwin ]]; then # macOS
		ifconfig | awk '{if($1=="inet" && $5=="broadcast") {print $2}}'
		ifconfig | awk '{if($1=="inet6" && $6=="secured") {print $2}}'
	fi
}

function chaincheck() {
	openssl s_client -verify 5 -quiet -connect "$1" 2>&1 < /dev/null | awk -F'=' '/CN/ {print $NF}'
}

function smbpath() {
	sed 's#\\#/#g' <<< "$1"
}

function dig-answer() {
	dig +noall +noclass +nottlid +answer "${@}" | column -t
}

function cppb() {
	echo -n "${PWD}/${1}" | pbcopy
}

function aws.getsecret() {
	aws secretsmanager get-secret-value \
		--secret-id "$1" \
		--query 'SecretString' \
		--output text
}

function aws.getsecrets() {
	aws secretsmanager get-secret-value \
		--secret-id "$1" |
		jq '.SecretString|fromjson'
}

function aws.env() {
	aws configure export-credentials --profile "${AWS_PROFILE}" --format env-no-export >.env
}

function aws.log() {
	if [ -z "$1" ]; then
		echo "Usage: aws.log <log-group-name> [--follow]" >&2
		return 1
	fi

	local LOG_GROUP="$1"
	local FOLLOW="$2"
	local LOG_STREAM

	LOG_STREAM=$(aws logs describe-log-streams \
		--log-group-name "$LOG_GROUP" \
		--order-by LastEventTime \
		--descending \
		--limit 1 \
		--query 'logStreams[0].logStreamName' \
		--output text 2>/dev/null)

	if [ -z "$LOG_STREAM" ] || [ "$LOG_STREAM" = "None" ]; then
		echo "No log streams found for group: $LOG_GROUP" >&2
		return 1
	fi

	echo "Log group:  $LOG_GROUP"
	echo "Log stream: $LOG_STREAM"

	if [ "$FOLLOW" = "--follow" ]; then
		aws logs tail "$LOG_GROUP" \
			--log-stream-names "$LOG_STREAM" \
			--follow
	else
		aws logs get-log-events \
			--log-group-name "$LOG_GROUP" \
			--log-stream-name "$LOG_STREAM" \
			--start-from-head \
			--output json |
			jq -r '.events[] | "[\(.timestamp | tonumber / 1000 | strftime("%Y-%m-%d %H:%M:%S"))] \(.message | gsub("\n$"; ""))"' |
			tr -d '\r'
	fi
}

function diskio() {
	# Parses BSD dd output and calls purge(8)
	if [[ "${OSTYPE}" != darwin* ]]; then
		echo "diskio: macOS only" >&2
		return 1
	fi
	if [[ ${EUID} -ne 0 ]]; then
		echo "diskio: this must be run as root" >&2
		return 1
	fi

	local testfile
	testfile="$(mktemp "${PWD}/diskio.XXXXXX")" || return 1
	trap 'rm -f "${testfile}"' INT

	echo -n "Running Write Test... "
	dd if=/dev/zero bs=2048k of="${testfile}" count=1024 2>&1 |\
		awk '/bytes/ {print $1/1024/1024/$5, "MB/sec"}'
	purge

	echo -n "Running Read Test...  "
	dd if="${testfile}" bs=2048k of=/dev/null count=1024 2>&1 |\
		awk '/bytes/ {print $1/1024/1024/$5, "MB/sec"}'
	purge

	rm -f "${testfile}"
	trap - INT
}
